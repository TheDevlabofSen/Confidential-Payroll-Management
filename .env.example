# Midnight Network Environment Variables

# Target Midnight Network: 'undeployed' (local devnet), 'preprod', or 'preview'
VITE_NETWORK=undeployed

# Deployed Contract Address (Recorded in .midnight-state.json after running npm run setup)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Midnight Proof Server URL
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# Private Storage Password (Minimum 16 characters)
PRIVATE_STATE_PASSWORD=Local-Devnet-Development-Placeholder-1
